			 inner join dim_sanctions_status_mls l on l.n_sanction_status_key = d.n_sanction_status_key and l.v_locale_code = 'en_US' 
			 INNER JOIN DIM_SANC_TF_ALERT_TYPE_TL alt on alt.N_ALERT_TYPE_CODE = fsi_rt_alerts.n_alert_type and alt.V_LOCALE_CODE = 'en_US'
			 LEFT JOIN (SELECT A2.N_GRP_MSG_ID, COUNT(A2.N_DOC_ID) DOCS_CNT FROM SETUP_DOC_MASTER A2
			 WHERE 1=1 and A2.F_ENABLED = 'A' GROUP BY A2.N_GRP_MSG_ID
			 ) A1 ON FSI_RT_ALERTS.N_GRP_MSG_ID = A1.N_GRP_MSG_ID
       left join fsi_rt_al_wls_response al on al.N_RESPONSE_ID = b.n_response_id
			 LEFT JOIN (select listagg(ct.v_crdtr_name,',') within group(order by ct.v_crdtr_name) v_crdtr_name,listagg(ct.v_crdtr_acct,',') within group(order by ct.v_crdtr_acct) v_crdtr_acct,ct.n_msg_tag_id  from fcc_tf_xml_cdtr_tag ct group by ct.n_msg_tag_id) cd ON cd.n_msg_tag_id = fsi_rt_alerts.n_grp_msg_id
			 LEFT JOIN (select listagg(dt.V_DBTR_NAME,',') within group(order by dt.V_DBTR_NAME) V_DBTR_NAME,listagg(dt.V_DBTR_ACCT,',') within group(order by dt.V_DBTR_ACCT) V_DBTR_ACCT,dt.n_msg_tag_id  from fcc_tf_xml_dbtr_tag dt group by dt.n_msg_tag_id) db ON db.n_msg_tag_id = fsi_rt_alerts.n_grp_msg_id
			 left join (select v1.V_STD_CMNT_NAME || NVL2(v2.V_STD_CMNT_NAME, '; ' || v2.V_STD_CMNT_NAME, '') v_std_cmnt_name, v1.N_ALERT_ID from 
				(select * from (select  REGEXP_SUBSTR (v_std_comnt_cd, '[^,]+', 1, 1)    AS cmt1, N_ALERT_ID from FCC_SAN_ALERT_STD_CMNTS_MAP) asm
				inner join FCC_SAN_STD_CMNTS_TL sd on asm.cmt1 = sd.v_std_comnt_cd and sd.V_LOCALE = 'en_US') v1
				left join (select * from (select  REGEXP_SUBSTR (v_std_comnt_cd, '[^,]+', 1, 2)    AS cmt2, N_ALERT_ID from FCC_SAN_ALERT_STD_CMNTS_MAP) asm
				inner join FCC_SAN_STD_CMNTS_TL sd on asm.cmt2 = sd.v_std_comnt_cd and sd.V_LOCALE = 'en_US') v2 on v1.N_ALERT_ID = v2.N_ALERT_ID) A3 
			on fsi_rt_alerts.n_alert_id = A3.N_ALERT_ID

			left join (SELECT c.n_alert_id ,LISTAGG(c.v_comments, ', ')WITHIN GROUP (ORDER BY c.v_comments) AS finalstandardcomment FROM fsi_rt_al_comments c INNER JOIN fsi_rt_alerts              e ON e.n_alert_id = c.n_alert_id and COMMENT_TYPE ='ALRT' 
        		GROUP BY c.n_alert_id) A4 on fsi_rt_alerts.n_alert_id = A4.N_ALERT_ID 

			 left join DIM_ALERT_PRIORITY_TYPE prt on prt.v_priority_code = fsi_rt_alerts.v_priority_type  
			 inner join DIM_ALERT_PRIORITY_TYPE_TL prtl on prt.v_priority_code = prtl.v_priority_code 
			 and prtl.v_locale_code = 'en_US' 
			 left join FCC_TF_EVENT_DETAILS on fsi_rt_alerts.N_GRP_MSG_ID = FCC_TF_EVENT_DETAILS.N_GRP_MSG_ID
			 where 1=1 and   
			 1 = ? and 
			  EXISTS ( SELECT 1 FROM DOMAIN_JUR_GRP_MAP INNER JOIN CSSMS_USR_GROUP_MAP ON DOMAIN_JUR_GRP_MAP.V_GROUP_CODE = CSSMS_USR_GROUP_MAP.V_GROUP_CODE WHERE DOMAIN_JUR_GRP_MAP.JRSDCN_CD = FSI_RT_ALERTS.JRSDCN_CD AND DOMAIN_JUR_GRP_MAP.BUS_DMN_CD = FSI_RT_ALERTS.BUS_DMN_CD AND DOMAIN_JUR_GRP_MAP.STATUS_CD = FSI_RT_ALERTS.N_STATUS_CD AND DOMAIN_JUR_GRP_MAP.ALERT_TYPE_CD = FSI_RT_ALERTS.N_ALERT_TYPE AND CSSMS_USR_GROUP_MAP.V_USR_ID = 'LAP5619' ) and 
			 upper(fsi_rt_alerts.v_grp_msg_type)  in (upper(?)) and
			 upper(z.v_msg_type_name) in (upper(?)) and 
			  
			  
			 upper(l.v_sanction_status_name) in (?,?) 
