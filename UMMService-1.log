                (case when (select count(1) from KDD_CASETYPE_TABGRP_MAP kctr where kc.CASE_TYPE_SUBTYPE_CD = kctr.CASE_TYPE_SUBTYPE_CD) != 0 then (select kctr.TAB_GRP_ID from KDD_CASETYPE_TABGRP_MAP kctr where kc.CASE_TYPE_SUBTYPE_CD = kctr.CASE_TYPE_SUBTYPE_CD) else 1 end) tab_group_id,
