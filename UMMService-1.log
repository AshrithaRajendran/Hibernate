[14-10-26 07:25:02,512 GMT AM] [DEBUG] [WEB]  [UMM]  [NA] [ECMDAO] getAllOwners select owner_seq_id,ownerid  from   (select  kro.owner_seq_id, kro.OWNER_ID ownerid,                   count(distinct kr.case_review_id) over(partition by kro.owner_seq_id ) cnt    from kdd_review_owner kro, cssms_usr_group_map cugm, cssms_group_role_map cgrm,    kdd_role_action_map kram, kdd_status_action_map ksam, kdd_cases kr, kdd_review_owner_jrsdcn kroj,    kdd_review_owner_case_type kroct, kdd_review_owner_org krorg  where kro.owner_id = cugm.v_usr_id     and cugm.v_group_code = cgrm.v_group_code     and kro.owner_type_cd = 'USER'       and kro.own_case_fl = 'Y'     AND kro.actv_fl = 'Y'     and cgrm.v_role_code = kram.role_cd     and kram.action_cd = ksam.action_cd     and ksam.status_cd = kr.status_cd  and kr.case_review_id in ( ? )      AND cm_overlays(kr.bus_dmn_st,CAST(kro.bus_dmn_st AS VARCHAR(255) )) = 'F'     and kroj.owner_seq_id = kro.owner_seq_id    AND kroj.jrsdcn_cd = kr.jrsdcn_cd    and kroct.owner_seq_id = kro.owner_seq_id    AND kroct.CASE_TYPE_CD = kr.case_type_subtype_cd    and krorg.owner_seq_id = kro.owner_seq_id    and krorg.org_cd = kr.owner_org and (kro.rptg_group_cd in
       (select /*+ precompute_subquery */ krog.org_cd
           from kdd_review_owner_org krog
          where krog.owner_seq_id =
