	and flgtl.V_LOCALE_CD = 'en_US' Where  m.v_case_intrl_id = kc.case_intrl_id) ws_case,
(select v_msg_ref from fcc_tf_esc_al_msg_tags n   inner join fcc_tf_esc_alert_case_map m
on n.n_alert_skey= m.n_alert_skey and m.v_case_intrl_id = kc.case_intrl_id and n.n_response_id is not null) msg_ref,
(select count(n.n_alert_skey) from fcc_tf_esc_al_events n   inner join fcc_tf_esc_alert_case_map m
on n.n_alert_skey= m.n_alert_skey and m.v_case_intrl_id = kc.case_intrl_id) linked_events_count,
kc.linked_case_ct linked_cases_count,
(select t.zcs_entity_alert_id from fcc_cs_esc_alerts t inner join fcc_cs_esc_alert_case_map m  on t.n_cm_alert_skey =m.n_alert_skey and  m.v_case_id = kc.case_intrl_id) alert_id ,
(select distinct t.assignee from fcc_cs_esc_alerts t inner join fcc_cs_esc_alert_case_map m  on t.n_cm_alert_skey =m.n_alert_skey and  m.v_case_id = kc.case_intrl_id) promoted_by ,
(select distinct at.v_action_name from fcc_cs_esc_alerts t inner join fcc_cs_cm_alert_actions_tl  at on t.v_action_code= at.v_action_cd inner join fcc_cs_esc_alert_case_map m  on t.n_cm_alert_skey =m.n_alert_skey and  m.v_case_id = kc.case_intrl_id) alert_decision ,
(select attrbt_val_tx from kdd_case_attrbt_val_map n where n.case_intrl_id  = kc.case_intrl_id and n.attrbt_id = 95) last_action_taken,
(Select pkg_cm_tabs.f_comment_concat_with_locale(F_CASE_LAST_STTS_ACTION_SEQ_ID(kc.case_intrl_id ),'en_US') from dual) last_comment,
