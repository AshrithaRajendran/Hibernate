    k.attrbt_val_tx   AS valuetext,
    k.attrbt_val_nb   AS valuenum,
    to_char(k.attrbt_val_dt, 'YYYY-MM-DD HH24:MI:SS') AS valuedate,
    k.attrbt_seq_nb   AS valuehier,
    cTL.attrbt_nm,
    cTL.attrbt_desc_tx,
    cta.attrbt_type_cd,
    cta.attrbt_dt_frmt,
    cta.attrbt_mndtry_fl,
    ct.dply_ordr,
    ct.attrbt_mndtry_fl
FROM
    kdd_case_attrbt_val_map   k,
    kdd_casetype_attrbt_map   ct,
    kdd_caseattrbt_master     cta,
    kdd_caseattrbt_master_tl    cTL
WHERE
    k.case_intrl_id = ?
    AND ct.case_type_subtype_cd = ?
    AND ct.attrbt_id = cta.attrbt_id
     AND ct.attrbt_id = cTL.attrbt_id
     and cTL.v_locale_cd='en_US'
    AND k.attrbt_id = cta.attrbt_id
UNION
SELECT
    cta.attrbt_id,
    '' AS valuetext,
    NULL AS valuenum,
    NULL AS valuedate,
    NULL AS valuehier,
    cTL.attrbt_nm,
    cTL.attrbt_desc_tx,
    cta.attrbt_type_cd,
    cta.attrbt_dt_frmt,
    cta.attrbt_mndtry_fl,
    ct.dply_ordr,
    ct.attrbt_mndtry_fl
FROM
    kdd_casetype_attrbt_map   ct,
    kdd_caseattrbt_master     cta,
    kdd_caseattrbt_master_tl cTL
WHERE
    ct.case_type_subtype_cd = ?
    AND ct.attrbt_id = cta.attrbt_id
    AND ct.attrbt_id = cTL.attrbt_id
    and cTL.v_locale_cd='en_US'
    AND cta.attrbt_id IN (
        SELECT
            cta.attrbt_id
        FROM
            kdd_casetype_attrbt_map   ct,
            kdd_caseattrbt_master     cta
        WHERE
            ct.case_type_subtype_cd = ?
            AND ct.attrbt_id = cta.attrbt_id
        MINUS
        SELECT
            cta.attrbt_id
        FROM
            kdd_case_attrbt_val_map   k,
            kdd_casetype_attrbt_map   ct,
            kdd_caseattrbt_master     cta,
            kdd_caseattrbt_master     cTL
        WHERE
            k.case_intrl_id = ?
            AND ct.case_type_subtype_cd = ?
            AND ct.attrbt_id = cta.attrbt_id
            AND ct.attrbt_id = cTL.attrbt_id
            and cTL.V_LOCALE_CD='en_US'
            AND cta.attrbt_id = k.attrbt_id
    )
ORDER BY
    11 ASC

