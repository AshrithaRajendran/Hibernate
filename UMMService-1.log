           ( select fps.n_precase_score from fcc_precase_score fps where fps.n_event_correlation_skey = tt.n_event_correlation_skey
            and fps.n_run_skey=tt.n_run_skey)
            END) pre_case_score,
      (select t.n_risk_score from fcc_tf_esc_alerts t inner join fcc_tf_esc_alert_case_map m
on t.n_alert_skey =m.n_alert_skey and m.v_case_intrl_id = kc.case_intrl_id ) risk_score,
(select t.n_score from fcc_tf_esc_alerts t inner join fcc_tf_esc_alert_case_map m
on t.n_alert_skey =m.n_alert_skey and m.v_case_intrl_id = kc.case_intrl_id ) match_score,
(select nvl(flgtl.v_ws_name, '-') from fcc_tf_esc_alerts t inner join fcc_tf_esc_alert_case_map m on t.n_alert_skey = m.n_alert_skey
