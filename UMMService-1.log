                kc.case_desc_tx descr,
                (select k.closed_status_fl from kdd_status k where k.status_cd = kc.status_cd) mstatus,
                kdd_jrsdcn.jrsdcn_dsply_nm jurisdiction,
                (select LISTAGG(kdd_bus_dmn.BUS_DMN_DSPLY_NM, ',') within group( order by 1) AS BUS_DMN_DSPLY_NM_AGGRT from kdd_bus_dmn_tl kdd_bus_dmn where CM_OVERLAYS(kdd_bus_dmn.BUS_DMN_CD, cast(kc.bus_dmn_st as varchar(255))) = 'F' and kdd_bus_dmn.v_locale_cd = 'en_US') bus_domain,
                (select jrsdcn_cd from kdd_jrsdcn where kc.jrsdcn_cd = kdd_jrsdcn.jrsdcn_cd ) juris,
    (select LISTAGG(kdd_bus_dmn.BUS_DMN_CD, '') within group( order by 1) AS BUS_DMN_DSPLY_NM_AGGRT from kdd_bus_dmn where CM_OVERLAYS(kdd_bus_dmn.BUS_DMN_CD, cast(kc.bus_dmn_st as varchar(255))) = 'F')  domain_cd,
                (select t.code_disp_tx from kdd_code_set_trnln_tl t where t.code_val = kc.status_cd and t.code_set='Case Masking' and t.V_LOCALE_CD = 'en_US') case_masking,
(select substr(regexp_replace(': ' || LISTAGG(V_ENTITY_TYPE, ': ' ON OVERFLOW TRUNCATE ) WITHIN GROUP(ORDER BY V_ENTITY_TYPE), '(:[^:]+)(\1)+', '\1'), 2)
  from fcc_correlation_event_map m inner join fcc_event_entity_map m1 on m.n_event_skey =   m1.n_event_skey and m1.V_FOCUS_FLAG = 'Y' and m1.f_migrated_event='N'
  where tt.n_event_correlation_skey = m.n_event_correlation_skey) entity_type,
(select substr(regexp_replace(': ' || LISTAGG(V_ENTITY_CD, ': ' ON OVERFLOW TRUNCATE) WITHIN GROUP(ORDER BY V_ENTITY_TYPE, V_ENTITY_CD), '(:[^:]+)(\1)+', '\1'), 2)
  from fcc_correlation_event_map m inner join fcc_event_entity_map m1 on m.n_event_skey = m1.n_event_skey and m1.V_FOCUS_FLAG = 'Y' and m1.f_migrated_event='N'
   where tt.n_event_correlation_skey = m.n_event_correlation_skey) entity_id,
(select substr(regexp_replace(': ' || LISTAGG(V_ENTITY_NAME, ': ' ON OVERFLOW TRUNCATE) WITHIN GROUP(ORDER BY V_ENTITY_TYPE,  V_ENTITY_CD), '(:[^:]+)(\1)+', '\1'), 2)
          from fcc_correlation_event_map m inner join fcc_event_entity_map m1 on m.n_event_skey = m1.n_event_skey
           and m1.V_FOCUS_FLAG = 'Y' and m1.f_migrated_event='N' where tt.n_event_correlation_skey = m.n_event_correlation_skey) entity_name,(select a.OWNER_ID from kdd_review_owner a where kc.create_by_id = a.owner_seq_id )created_by_id,(case when (select count(1) from kdd_review_owner_csetyp_rdonly rd  where rd.case_type_cd=kc.CASE_TYPE_SUBTYPE_CD and rd.owner_seq_id=(select t.owner_seq_id from kdd_review_owner t where t.owner_id='MBM4859'))!=0 then 'Y' else 'N' end) read_only_flag,
           kc.age case_age,
            (CASE WHEN kc.case_type_subtype_cd in('KYC_IND','KYC_FIRM','KYC_CORP') THEN
